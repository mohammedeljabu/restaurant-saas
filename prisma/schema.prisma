
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  WAITING_PAYMENT
  OUT_OF_SERVICE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  name          String
  passwordHash  String
  role          UserRole @default(MANAGER)
  avatarUrl     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  restaurantsOwned Restaurant[] @relation("Owner")
  memberships      Employee[]
  auditLogs        AuditLog[]
}

model Restaurant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  logoUrl       String?
  coverUrl      String?
  description   String?
  phone         String?
  whatsapp      String?
  address       String?
  lat           Float?
  lng           Float?
  currency      String   @default("LYD")
  taxRate       Float    @default(0)
  serviceFeeRate Float   @default(0)
  customDomain  String?  @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ownerId       String
  owner         User     @relation("Owner", fields: [ownerId], references: [id])
  branches      Branch[]
  subscription  Subscription?
  employees     Employee[]
  menuCategories MenuCategory[]
  customers     Customer[]
  coupons       Coupon[]
  suppliers     Supplier[]
}

model Branch {
  id            String   @id @default(cuid())
  slug          String
  name          String
  address       String?
  phone         String?
  lat           Float?
  lng           Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables        Table[]
  employees     Employee[]
  orders        Order[]
  tableSessions TableSession[]
  inventoryItems InventoryItem[]
  @@unique([restaurantId, slug])
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  priceMonthly  Float
  priceYearly   Float
  features      Json
  maxBranches   Int      @default(1)
  maxTables     Int      @default(10)
  maxEmployees  Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id            String             @id @default(cuid())
  status        SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt   DateTime?
  graceUntil    DateTime?
  couponCode    String?
  restaurantId  String   @unique
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Employee {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  role          UserRole
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  @@unique([userId, restaurantId, branchId])
}

model Table {
  id            String      @id @default(cuid())
  number        String
  capacity      Int         @default(4)
  floor         String?
  x             Float?
  y             Float?
  status        TableStatus @default(AVAILABLE)
  isActive      Boolean     @default(true)
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrCode        QrCode?
  sessions      TableSession[]
  orders        Order[]
  @@unique([branchId, number])
}

model QrCode {
  id            String   @id @default(cuid())
  token         String   @unique @default(cuid())
  url           String
  design        Json?
  createdAt     DateTime @default(now())
  tableId       String   @unique
  table         Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model TableSession {
  id            String   @id @default(cuid())
  status        String   @default("OPEN")
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  tableId       String
  table         Table    @relation(fields: [tableId], references: [id])
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  restaurantId  String
  orders        Order[]
}

model MenuCategory {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  slug          String
  imageUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         MenuItem[]
  @@unique([restaurantId, slug])
}

model MenuItem {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  imageUrl      String?
  price         Float
  discountPrice Float?
  isAvailable   Boolean  @default(true)
  prepTime      Int?
  sortOrder     Int      @default(0)
  restaurantId  String
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id])
  branchId      String?
  modifierGroups MenuItemModifierGroup[]
  orderItems    OrderItem[]
  recipe        Recipe?
}

model ModifierGroup {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  isRequired    Boolean  @default(false)
  minSelect     Int      @default(0)
  maxSelect     Int      @default(1)
  sortOrder     Int      @default(0)
  restaurantId  String
  modifiers     Modifier[]
  menuItems     MenuItemModifierGroup[]
}

model Modifier {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  price         Float    @default(0)
  isAvailable   Boolean  @default(true)
  groupId       String
  group         ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model MenuItemModifierGroup {
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId       String
  modifierGroup ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([menuItemId, groupId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int         @unique @default(autoincrement())
  type          OrderType   @default(DINE_IN)
  status        OrderStatus @default(NEW)
  subtotal      Float
  discount      Float       @default(0)
  tax           Float       @default(0)
  serviceFee    Float       @default(0)
  deliveryFee   Float       @default(0)
  total         Float
  customerName  String?
  customerPhone String?
  deliveryAddress String?
  deliveryLat   Float?
  deliveryLng   Float?
  notes         String?
  restaurantId  String
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id])
  sessionId     String?
  session       TableSession? @relation(fields: [sessionId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  quantity      Int      @default(1)
  unitPrice     Float
  totalPrice    Float
  notes         String?
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  modifiers     OrderItemModifier[]
}

model OrderItemModifier {
  id            String   @id @default(cuid())
  name          String
  price         Float
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId    String?
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedById   String?
  changedAt     DateTime    @default(now())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  method        PaymentMethod
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
}

model Customer {
  id            String   @id @default(cuid())
  name          String?
  phone         String
  email         String?
  totalOrders   Int      @default(0)
  totalSpent    Float    @default(0)
  loyaltyPoints Int      @default(0)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]
  @@unique([restaurantId, phone])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String
  discountType  String
  discountValue Float
  minOrder      Float?
  maxUsage      Int?
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  @@unique([restaurantId, code])
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  unit          String
  quantity      Float
  minQuantity   Float    @default(0)
  cost          Float
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
}

model Recipe {
  id            String   @id @default(cuid())
  menuItemId    String   @unique
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients   RecipeIngredient[]
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  quantity        Float
  recipeId        String
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  entity        String
  entityId      String?
  data          Json?
  createdAt     DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
}
